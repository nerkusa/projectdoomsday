          }
        },
        {
          "text": "[Уйти]",
          "next": null
        }
      ]
    },
    "where": {
      "text": "Баржи с Вилюя, раз в месяц. Что с барж не придёт — того нет. Контора всё берёт первая, нам — остатки.",
      "options": [
        {
          "text": "…",
          "next": "about"
        }
      ]

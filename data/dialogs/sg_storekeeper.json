    "name": {
      "text": "(Туйаара пожимает плечами.) Так на вывеске написано. Второй этаж был — «Ткани», «Обувь», «Игрушки». Теперь там склад и крысы.",
      "options": [
        {
          "text": "…",
          "next": "about"
        }
      ]
    },
    "about": {
      "text": "Спрашивай.",
      "options": [
        {
          "text": "Откуда товар?",
          "next": "where"
        },
        {
          "text": "Почему «универмаг»? Тут же одна комната.",
          "next": "name"
        },
        {
          "text": "Ладно, о другом.",
          "next": "start",
          "back": true
        }

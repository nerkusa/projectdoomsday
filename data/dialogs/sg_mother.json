    "exam_ok": {
      "text": "(Горло красное, хрипов нет.) Не воспаление — простуда с жаром. Поить, обтирать, и что-то от жара: травы или аптечка.",
      "xp": 20,
      "quest": {
        "id": "sg_medicine",
        "stage": 1

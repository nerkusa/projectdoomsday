            "stage_min": 3
          },
          "text": "Ведро — как новое! Ты это, заходи. Воды всегда налью."
        }
      ],
      "options": [
        {
          "text": "Достану. Верёвку бы только.",
          "next": null,
          "if": {
            "quest": "well",
            "stage_max": 0
          },
          "quest": {
            "id": "well",
            "stage": 1
          }

            "not_flag": "hunter_done"
          },
          "quest": {
            "id": "hunter",
            "stage": 1
          },
          "check": {
            "stat": "BODY",
            "skill": "Запугивание",
            "dc": 13
          },
          "success": "scared",
          "fail": "not_scared"
        },
        {
          "text": "Почему зверь пуганый?",
          "next": "tracks"
        },
        {
          "text": "[Уйти]",
          "next": null
        }
      ]
    },
    "spar": {
      "text": "Нож убери. Вот так. Начали!",
      "action": "hunter_spar",
      "options": []
    },
    "won": {
      "text": "Кх... Крепко бьёшь. Годишься. Держи — вяленый чир, в тайге первое дело. И мясо, и соль.",

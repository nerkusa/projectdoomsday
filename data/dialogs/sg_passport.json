      "xp": 30,
      "options": [
        {
          "text": "…",
          "next": "start"
        }
      ]
    },
    "issue_lie": {
      "text": "(Паспортистка поджимает губы.) Опять конторские без очереди… Держите.",
      "give": {
        "propiska": 1
      },
      "set_flags": {
        "sg_permit": true
      },
      "quest": {
        "id": "sg_permit",
        "stage": 2
